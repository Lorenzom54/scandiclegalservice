  <div class="mobile-hero-image">
    <!-- Overlay oscuro para legibilidad del texto -->
    <div class="mobile-hero-overlay"></div>
    
    <!-- Contenido superpuesto sobre la imagen (solo móvil) -->
    <div class="mobile-hero-content">
      <!-- Texto sobre la imagen -->
      <h1 class="mobile-hero-title" data-i18n="hero.mainTitle">
        Evita riesgos y ahorra tiempo en compras de propiedades, herencias y trámites fiscales
