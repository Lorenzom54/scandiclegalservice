  <div class="absolute bottom-8 left-8 z-20 hero-logo-corner">
    <img src="/logo.png" alt="Scandic Legal Service" class="h-20 sm:h-24 md:h-28 w-auto object-contain opacity-80 hover:opacity-100 transition-opacity">
  </div>
