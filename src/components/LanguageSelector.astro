---
---

<div class="relative language-selector-wrapper">
  <button class="lang-selector-btn flex items-center space-x-1 px-3 py-2 text-sm bg-white border border-gray-300 rounded-md hover:bg-gray-50 transition-colors">
    <span class="text-lg">🌐</span>
    <span class="current-lang font-medium">NO</span>
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
    </svg>
  </button>
  
  <div class="lang-dropdown absolute right-0 top-full mt-1 w-20 bg-white border border-gray-300 rounded-md shadow-lg z-50 hidden">
    <button class="lang-option w-full px-3 py-2 text-left text-sm hover:bg-gray-50 transition-colors" data-lang="es">ES</button>
    <button class="lang-option w-full px-3 py-2 text-left text-sm hover:bg-gray-50 transition-colors" data-lang="en">EN</button>
    <button class="lang-option w-full px-3 py-2 text-left text-sm hover:bg-gray-50 transition-colors" data-lang="no">NO</button>
  </div>
</div>

<script>
  import { translations } from '../data/translations.js';
  
  // Get current language from localStorage or default to 'no'
  let currentLang = localStorage.getItem('scandic-lang') || 'no';
  
  // Update all text elements with current language
  function updateLanguage(lang) {
    currentLang = lang;
    localStorage.setItem('scandic-lang', lang);
    
    const t = translations[lang];
    
    // Update current language display in all selectors
    document.querySelectorAll('.current-lang').forEach(element => {
      element.textContent = lang.toUpperCase();
    });
    
    // Update all elements with data-i18n attributes
    document.querySelectorAll('[data-i18n]').forEach(element => {
      const key = element.getAttribute('data-i18n');
      const keys = key.split('.');
      let value = t;
      
      for (const k of keys) {
        value = value[k];
      }
      
      if (value) {
        if (element.tagName === 'INPUT' && element.type !== 'submit') {
          element.placeholder = value;
        } else {
          // Use innerHTML if value contains HTML tags, otherwise use textContent
          if (value.includes('<') && value.includes('>')) {
            element.innerHTML = value;
          } else {
            element.textContent = value;
          }
        }
      }
    });
    
    // Close all dropdowns
    document.querySelectorAll('.lang-dropdown').forEach(dropdown => {
      dropdown.classList.add('hidden');
    });
  }
  
  // Initialize language on page load
  document.addEventListener('DOMContentLoaded', () => {
    // Set initial language display
    updateLanguage(currentLang);
    
    // Setup each language selector instance
    document.querySelectorAll('.language-selector-wrapper').forEach(wrapper => {
      const selectorBtn = wrapper.querySelector('.lang-selector-btn');
      const dropdown = wrapper.querySelector('.lang-dropdown');
      const currentLangSpan = wrapper.querySelector('.current-lang');
      
      if (selectorBtn && dropdown && currentLangSpan) {
        // Set initial language display for this instance
        currentLangSpan.textContent = currentLang.toUpperCase();
        
        // Language selector toggle
        selectorBtn.addEventListener('click', (e) => {
          e.stopPropagation();
          dropdown.classList.toggle('hidden');
        });
        
        // Language option selection
        wrapper.querySelectorAll('.lang-option').forEach(option => {
          option.addEventListener('click', (e) => {
            e.stopPropagation();
            updateLanguage(option.dataset.lang);
          });
        });
      }
    });
    
    // Close dropdown when clicking outside
    document.addEventListener('click', (e) => {
      if (!e.target.closest('.language-selector-wrapper')) {
        document.querySelectorAll('.lang-dropdown').forEach(dropdown => {
          dropdown.classList.add('hidden');
        });
      }
    });
  });
</script>