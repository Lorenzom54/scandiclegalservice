---
import Layout from '../layouts/Layout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';

export interface Props {
  title: string;
  description: string;
  serviceKey: 'tax' | 'property' | 'inheritance' | 'general';
}

const { title, description, serviceKey } = Astro.props;

const serviceIcons = {
  tax: `<svg class="w-8 h-8 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z"></path>
  </svg>`,
  property: `<svg class="w-8 h-8 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path>
  </svg>`,
  inheritance: `<svg class="w-8 h-8 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
  </svg>`,
  general: `<svg class="w-8 h-8 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2-2v2m8 0V6a2 2 0 012 2v6a2 2 0 01-2 2H6a2 2 0 01-2-2V8a2 2 0 012-2V6"></path>
  </svg>`
};
---

<Layout title={title} description={description}>
  <Header />
  <main>
    <!-- Breadcrumb -->
    <nav class="bg-gray-50 pt-28 pb-4 md:pt-28 lg:pt-32 xl:pt-36">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <ol class="flex items-center space-x-2 text-sm">
          <li><a href="/" class="text-gray-500 hover:text-primary transition-colors">Inicio</a></li>
          <li class="text-gray-400">/</li>
          <li><a href="/#services" class="text-gray-500 hover:text-primary transition-colors">Servicios</a></li>
          <li class="text-gray-400">/</li>
          <li class="text-gray-800 font-medium"><slot name="breadcrumb" /></li>
        </ol>
      </div>
    </nav>

    <!-- Hero Section -->
    <section class="py-16 bg-gradient-to-b from-primary/5 to-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <div class="inline-flex items-center justify-center w-16 h-16 bg-primary/10 rounded-lg mb-6 mt-4 md:mt-6 lg:mt-8" set:html={serviceIcons[serviceKey]} />
          <h1 class="text-4xl md:text-5xl font-bold text-dark mb-4">
            <slot name="title" />
          </h1>
          <p class="text-xl text-gray-600 max-w-3xl mx-auto">
            <slot name="subtitle" />
          </p>
        </div>
      </div>
    </section>

    <!-- Content Section -->
    <section class="py-16 bg-secondary">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <slot />
      </div>
    </section>

    <!-- CTA Section -->
    <section class="py-16 bg-primary text-white">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h2 class="text-3xl md:text-4xl font-bold mb-4">¿Necesitas ayuda con este servicio?</h2>
        <p class="text-xl mb-8 text-white/90">Contacta con nosotros y te asesoraremos sin compromiso</p>
        <a 
          href="https://cloud-s23.mnprogram.net/Index.aspx?frm=DAF6F06B-7DA0-49A9-B613-887B49F5B84B" 
          target="_blank"
          class="inline-block bg-white text-primary px-8 py-4 rounded-lg font-semibold text-lg transition-all duration-300 transform hover:scale-105 shadow-lg hover:shadow-xl"
        >
          Contactar Ahora
        </a>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  nav ol li:last-child {
    color: #1a1a1a;
  }
</style>

